# Environment Configuration for AI Agent VPS
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=false

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_api_key

# Model Configuration
DEFAULT_MODEL=claude-sonnet-4-5-20250929
FALLBACK_MODEL=gpt-4-turbo
SMALL_MODEL=claude-haiku-4-5

# Agent Configuration
AGENT_TIMEOUT=300
MAX_RETRIES=3
RETRY_DELAY=1.0

# Sandbox Configuration
SANDBOX_ENABLED=true
SANDBOX_WORKSPACE=/home/ubuntu/workspace

# Git Configuration
GIT_DEFAULT_BRANCH=main
GIT_AUTHOR_NAME=AI Orchestrator
GIT_AUTHOR_EMAIL=ai@orchestrator.local

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_PATH=/home/ubuntu/data/logs

# Monitoring Configuration
ENABLE_TRACING=true
ENABLE_METRICS=true
# OTLP_ENDPOINT=http://localhost:4317

# Security Configuration
ENABLE_SECURITY=true

# Memory Configuration
SHORT_TERM_TTL=900
MEDIUM_TERM_TTL=86400

# Cost Management
COST_ALERT_THRESHOLD=100.0
DAILY_TOKEN_LIMIT=1000000

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection (either DATABASE_URL or individual vars)
DATABASE_URL=postgresql://orchestrator:password@127.0.0.1:5432/orchestrator
# OR individual vars:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=orchestrator
# DB_USER=orchestrator
# DB_PASSWORD=yourpassword

# Telegram notifications (optional — skip to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (required for PR workflow)
GITHUB_TOKEN=

# ── Paths ─────────────────────────────────────────────────────────────────────

# Root directory containing your project workspaces
WORKSPACE_ROOT=/path/to/workspaces

# Claude Code CLI binary (defaults to 'claude' on PATH)
CLAUDE_BIN=claude

# Audit log output path
AUDIT_LOG_PATH=logs/orchestrator-audit.log

# ── Optional integrations ─────────────────────────────────────────────────────

# Qdrant (for RAG knowledge retrieval)
# QDRANT_URL=http://127.0.0.1:6333

# Redis (for knowledge search caching)
# REDIS_PASSWORD=

# LightRAG graph query (optional — Qdrant used as fallback)
# LIGHTRAG_URL=http://127.0.0.1:11236

# Knowledge base path (for keyword grep fallback)
# KNOWLEDGE_PATH=knowledge

# Research output path
# RESEARCH_PATH=knowledge/research

# Claude skills directory (optional — for injecting skill content into prompts)
# SKILLS_DIR=.claude/skills

# Claude usage state (optional — for quota-aware scheduling)
# CLAUDE_USAGE_STATE_PATH=.claude/usage_state.json

# Claude session projects root (optional — for session resumption)
# CLAUDE_PROJECTS_ROOT=.claude/projects

# ── Git identity ──────────────────────────────────────────────────────────────
GIT_USER_NAME=orchestrator
GIT_USER_EMAIL=orchestrator@local

# SSH key for git operations (optional — uses default SSH agent if not set)
# GIT_SSH_KEY=/path/to/ssh/key

# ── Policy ────────────────────────────────────────────────────────────────────
# Path to policy.conf (see policy.conf.example)
# POLICY_CONF_PATH=policy.conf

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ_LOCAL=UTC
